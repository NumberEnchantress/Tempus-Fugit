<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- The time zone is set at runtime through RemoteViews (TextClock.setTimeZone).
         Hidden until then, so it never shows device time under a "solar" label. -->
    <TextClock
        android:id="@+id/widget_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="@color/widget_text"
        android:textSize="40sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_placeholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:includeFontPadding="false"
        android:text="@string/no_time_minutes"
        android:textColor="@color/widget_text"
        android:textSize="40sp" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/no_fix_yet"
        android:textColor="@color/widget_label"
        android:textSize="12sp" />
</LinearLayout>
